; Engine configuration file for MARIGOLD - A Dia de Muertos Journey.

config_version=5

[application]

config/name="MARIGOLD"
config/version="0.9.1"
config/description="A Dia de Muertos journey through the Land of the Dead. Original 10-minute guided experience for Meta Quest 3 with hand tracking, AR mode, and Check for Updates built in."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

MarigoldState="*res://scripts/shared/state.gd"
MarigoldPause="*res://scripts/shared/pause_menu.gd"
MarigoldVoice="*res://scripts/shared/voice.gd"
MarigoldCaptions="*res://scripts/shared/captions.gd"
MarigoldVignette="*res://scripts/shared/vignette.gd"
GameplayTelemetry="*res://scripts/shared/gameplay_telemetry.gd"
BugReporter="*res://scripts/shared/bug_reporter.gd"
CandleMelt="*res://scripts/shared/candle_melt.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

